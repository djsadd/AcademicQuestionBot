APP_ENV=local

API_PORT=18000
PLATONUS_API_PORT=18001
FRONTEND_PORT=18030
POSTGRES_PORT=15432
QDRANT_PORT=16333
REDIS_PORT=16379

POSTGRES_DSN=postgresql://bot:bot@postgresql:5432/bot
PLATONUS_API_URL=http://platonus-api:8001

QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=academic_documents
QDRANT_STRICT=true
QDRANT_RETRY_ATTEMPTS=15
QDRANT_RETRY_DELAY=0.2
QDRANT_RETRY_MAX_DELAY=2.0
QDRANT_FALLBACK_ENABLED=true
QDRANT_STARTUP_TIMEOUT=60

REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0

RAG_STORAGE_PATH=/app/storage/documents
RAG_COMPRESSION_MAX_CHARS=1800
RAG_COMPRESSION_MAX_TOKENS=180
OCR_ENABLED=true
OCR_LANG=rus+eng+kaz

OPENAI_API_KEY=
OPENAI_TEAM=
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDINGS_MODEL=text-embedding-3-large
OPENAI_EMBEDDINGS_DIM=3072
OPENAI_EMBEDDINGS_URL=https://api.openai.com/v1/embeddings

VITE_API_BASE_URL=/api
VITE_TELEGRAM_BOT_USERNAME=

TELEGRAM_BOT_TOKEN=
TELEGRAM_LOGIN_MAX_AGE=86400
TELEGRAM_POLL_TIMEOUT=20
TELEGRAM_POLL_INTERVAL=1
TELEGRAM_MINI_APP_URL=

JWT_SECRET=
JWT_ACCESS_TTL_MINUTES=30
JWT_REFRESH_TTL_DAYS=14
ADMIN_ROLES=admin,administrator,superuser,staff,dean,deanery

PLATONUS_LOGIN=
PLATONUS_PASSWORD=
PLATONUS_ADMIN_LOGIN=
PLATONUS_ADMIN_PASSWORD=
