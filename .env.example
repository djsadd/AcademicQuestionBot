APP_ENV=local
LOG_LEVEL=INFO
LOG_JSON=false
# Comma separated list of allowed origins for the API (use "*" only for local dev)
CORS_ORIGINS=*
API_WORKERS=2
# Interface the API port is published on (127.0.0.1 = only via the frontend proxy)
API_BIND=127.0.0.1

API_PORT=18000
PLATONUS_API_PORT=18001
FRONTEND_PORT=18030
POSTGRES_PORT=15432
QDRANT_PORT=16333
REDIS_PORT=16379

POSTGRES_USER=bot
POSTGRES_PASSWORD=bot
POSTGRES_DB=bot
POSTGRES_DSN=postgresql://bot:bot@postgresql:5432/bot
DB_POOL_MIN=1
DB_POOL_MAX=10
PLATONUS_API_URL=http://platonus-api:8001

QDRANT_VERSION=latest
QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=academic_documents
QDRANT_STRICT=true
QDRANT_RETRY_ATTEMPTS=15
QDRANT_RETRY_DELAY=0.2
QDRANT_RETRY_MAX_DELAY=2.0
QDRANT_FALLBACK_ENABLED=true
QDRANT_STARTUP_TIMEOUT=60

REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0

RAG_STORAGE_PATH=/app/storage/documents
RAG_COMPRESSION_MAX_CHARS=1800
RAG_COMPRESSION_MAX_TOKENS=180
RAG_TOP_K=5
RAG_CHUNK_SIZE=1100
RAG_CHUNK_OVERLAP=180
RAG_MIN_SCORE=0.2
RAG_COMPRESSION_ENABLED=true
RAG_COMPRESSION_WORKERS=4
RAG_MAX_UPLOAD_MB=50
OCR_ENABLED=true
OCR_LANG=rus+eng+kaz

OPENAI_API_KEY=
OPENAI_TEAM=
# Any OpenAI-compatible endpoint (OpenAI, Azure gateway, vLLM, Ollama, LM Studio)
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
# Optional cheaper model for intent routing and context compression
OPENAI_FAST_MODEL=
OPENAI_MAX_TOKENS=1600
OPENAI_TIMEOUT=45
OPENAI_MAX_RETRIES=2
OPENAI_EMBEDDINGS_MODEL=text-embedding-3-large
OPENAI_EMBEDDINGS_DIM=3072
OPENAI_EMBEDDINGS_URL=https://api.openai.com/v1/embeddings
OPENAI_EMBEDDINGS_BATCH=64

# Agent pipeline & public chat protection
AGENT_TIMEOUT_SECONDS=40
CHAT_MAX_MESSAGE_CHARS=4000
PUBLIC_RATE_LIMIT_PER_MINUTE=20
CHAT_RATE_LIMIT_PER_MINUTE=60

VITE_API_BASE_URL=/api
VITE_TELEGRAM_BOT_USERNAME=

TELEGRAM_BOT_TOKEN=
TELEGRAM_LOGIN_MAX_AGE=86400
TELEGRAM_POLL_TIMEOUT=20
TELEGRAM_POLL_INTERVAL=1
TELEGRAM_MINI_APP_URL=

JWT_SECRET=
JWT_ACCESS_TTL_MINUTES=30
JWT_REFRESH_TTL_DAYS=14
ADMIN_ROLES=admin,administrator,superuser,staff,dean,deanery
# Logins (Platonus) or internal user ids that are always admins — use it to bootstrap the first admin
ADMIN_LOGINS=

PLATONUS_LOGIN=
PLATONUS_PASSWORD=
PLATONUS_ADMIN_LOGIN=
PLATONUS_ADMIN_PASSWORD=
# Shown by the password-help flow
PLATONUS_RESET_URL=
IT_SUPPORT_CONTACT=
