  "admission_exams": {
    "en": {
      "sections": [
        {
          "key": "ent",
          "title": "UNT for bachelor programs",
          "items": [
            "UNT is required for admission to bachelor programs.",
            "The subject combination determines the list of available educational programs.",
            "Main UNT 2026: registration from April 11 to April 25, 2026; exam from May 10 to July 10, 2026.",
            "Additional UNT attempts: January UNT registration is in December with the exam in January-February; March UNT registration is in February with the exam in March-April."
          ]
        },
        {
          "key": "kt",
          "title": "CT for master's programs",
          "items": [
            "CT is required for admission to master's programs.",
            "The comprehensive test includes a foreign language, a learning readiness test, and profile disciplines.",
            "Registration usually takes place in June-July.",
            "Exams usually take place in July-August.",
            "Exact dates are approved annually by the National Testing Center; registration is completed at app.testcenter.kz."
          ]
        },
        {
          "key": "doctorate",
          "title": "PhD doctorate",
          "items": [
            "Admission to doctoral studies requires an IELTS or TOEFL language certificate.",
            "The exact language certificate threshold depends on the university requirements.",
            "Applicants must pass an entrance exam in the specialty.",
            "Applications are accepted from early July to approximately August 3.",
            "Entrance exams are held from August 4 to August 20.",
            "Admission is conducted through an interview and competition."
          ]
        }
      ],
      "updated_at": "2026-04-29"
    }
  },
